Notebook[{

Cell[CellGroupData[{
Cell["Quantum Optimization of Antenna Tilt - Real OpenCelliD Data", "Title",ExpressionUUID->"be057df3-0f73-de47-8355-6b86686c863b"],

Cell["\<\
QAOA, VQE and Grover on a 6-antenna, 12-qubit statevector simulation (QUBIT \
2026 / Quantum Headache)\
\>", "Subtitle",ExpressionUUID->"a87cab21-cb6e-124b-8fbd-c51d2969ae38"],

Cell["\<\
Every number and plot below is produced by the verified pipeline in \
wolfram_realdataset_algorithms.wl (same directory). The first cell runs it \
end to end (~60-80 s, VQE dominates) and leaves all states and results in the \
kernel; the remaining cells only visualize them. Cost(t) = t.I.t - lambda c.t \
+ mu sum(t) with lambda = 1.5, mu = 0.3; tilt levels 0..3 per antenna.\
\>", "Text",ExpressionUUID->"e9f316c7-f4b8-7040-8a71-f092a90e092f"],

Cell[CellGroupData[{

Cell["1. Run the verified pipeline", "Section",ExpressionUUID->"c6d25616-3d21-5048-b955-8f786ffe6934"],

Cell[CellGroupData[{

Cell["\<\
projDir = ParentDirectory[NotebookDirectory[]];
Get[FileNameJoin[{NotebookDirectory[], \
\"wolfram_realdataset_algorithms.wl\"}]];\
\>", "Input",
 FontSize->9,ExpressionUUID->"205897fb-329e-7c43-9f99-2dd434a9e7a0"],

Cell[CellGroupData[{

Cell[BoxData[
 TemplateBox[{
  "\"instance: \"", "6", "\" antennas, \"", "12", "\" qubits, dim \"", "4096"},
  "RowDefault"]], "Print",ExpressionUUID->"55560ad0-9e1f-d54b-8b53-\
3f902394ad9f"],

