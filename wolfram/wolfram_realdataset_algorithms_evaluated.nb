Cell["\<\
Compact metric for the pitch: the probability that one shot returns a \
configuration with negative cost (i.e. coverage gain beats interference + \
tilt penalty).\
\>", "Text",ExpressionUUID->"2402e80f-584c-5742-b202-5b6c8c6eecea"],

Cell[CellGroupData[{

Cell["\<\
pNeg[psi_] := Total[Pick[probs[psi], Negative[costVec]]];
BarChart[{pNeg[hInit], pNeg[psiP1], pNeg[psiP2], pNeg[psiVqe]},
 ChartLabels -> {\"uniform\", \"QAOA p=1\", \"QAOA p=2\", \"VQE\"}, \
ChartStyle -> \"Pastel\",
 Frame -> True, FrameLabel -> {None, \"P(cost < 0) per shot\"}, ImageSize -> \
500,
 LabelingFunction -> (Placed[NumberForm[100 #, {3, 1}] \"%\", Above] &)]\
\>", "Input",
 FontSize->9,
 CellTags->"pneg",ExpressionUUID->"96df7c17-2576-8c43-99de-7fbd4ddcc11e"],

