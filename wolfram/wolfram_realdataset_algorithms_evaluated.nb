Cell[CellGroupData[{

Cell["5. Most likely tilt configurations sampled from QAOA p=2", "Section",ExpressionUUID->"5bffb4f7-6842-5846-af8c-6a596c572c5f"],

Cell[CellGroupData[{

Cell["\<\
top = Ordering[probs[psiP2], -10];
Grid[Prepend[Table[{tilts[i - 1], NumberForm[costVec[[i]], {5, 3}],
    Row[{NumberForm[100 probs[psiP2][[i]], {4, 2}], \" %\"}]}, {i, top}],
  Style[#, Bold] & /@ {\"tilts (antennas 1..6)\", \"cost\", \"P(sample)\"}],
 Frame -> All, Alignment -> Left, Spacings -> {2, 0.6}]\
\>", "Input",
 FontSize->9,
 CellTags->"top",ExpressionUUID->"30d1a83d-36b4-e542-8704-06c15ad01c8b"],

