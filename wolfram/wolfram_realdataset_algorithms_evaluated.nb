Cell[CellGroupData[{

Cell["\<\
psi3 = Nest[diff.(marked.#) &, N[uni], 3];
BarChart[Abs[psi3]^2,
 ChartLabels -> Table[StringRiffle[tilts[i][[1 ;; 2]], \",\"], {i, 0, dim2 - \
1}],
 ChartStyle -> {Table[If[MemberQ[opt2, i], Red, LightBlue], {i, 1, dim2}]},
 Frame -> True, FrameLabel -> {\"tilts (antenna 1, antenna 2)\", \
\"probability after k = 3\"}, ImageSize -> 600]\
\>", "Input",
 FontSize->9,
 CellTags->"grover16",ExpressionUUID->"aabc35b1-850f-b145-8288-a8c28aaa917d"],

