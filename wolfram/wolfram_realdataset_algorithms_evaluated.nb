Cell[CellGroupData[{

Cell["3. QAOA p=1 parameter landscape  <C>(gamma, beta)", "Section",ExpressionUUID->"49fd1bb1-ff5e-8e47-a9d7-edae45d3c730"],

Cell["\<\
The expected cost after one phase + one mixer layer. Most of the surface is a \
flat plateau at the mean; the optimizer (black dot) sits in the narrow \
low-cost valley near small gamma.\
\>", "Text",ExpressionUUID->"3432cad7-aff8-6344-8965-1d2a9bcb2acf"],

Cell[CellGroupData[{

Cell["\<\
DensityPlot[qaoaP1[g, b], {g, 0, 0.3}, {b, 0, Pi},
 PlotPoints -> 25, MaxRecursion -> 0, ColorFunction -> \"TemperatureMap\",
 PlotLegends -> BarLegend[Automatic, LegendLabel -> \"<C>\"],
 FrameLabel -> {\"gamma (phase angle)\", \"beta (mixer angle)\"}, ImageSize \
-> 500,
 Epilog -> {Black, PointSize[Large], Point[{p1res[\"gamma\"], \
p1res[\"beta\"]}],
   Text[Style[\"NMinimize optimum\", Black, 12], {p1res[\"gamma\"], \
p1res[\"beta\"]}, {-1.15, 0}]}]\
\>", "Input",
 FontSize->9,
 CellTags->"landscape",ExpressionUUID->"2991b11c-ba37-1449-9df2-b68a350fe1a2"],

