Cell[CellGroupData[{

Cell["2. Cost landscape of all 4096 tilt configurations", "Section",ExpressionUUID->"589592f7-84f3-3149-bb3d-ea707ab6a847"],

Cell["\<\
Exact enumeration. The optimum is a single configuration; a uniform random \
guess sits at the mean (~35.5).\
\>", "Text",ExpressionUUID->"63950fa1-f70d-eb4f-a676-e7a04d545ab8"],

Cell[CellGroupData[{

Cell["\<\
Histogram[costVec, 60, \"Count\", PlotRange -> All, Frame -> True,
 FrameLabel -> {\"Cost(t)\", \"number of tilt configurations\"}, ChartStyle \
-> LightBlue, ImageSize -> 600,
 GridLines -> {{{minCost, Directive[Red, Thick]}, {Mean[costVec], \
Directive[Gray, Dashed]}}, None},
 PlotLabel -> Row[{\"red = optimum \", minCost, \" at tilts \", \
tilts[First[optIdx] - 1],
   \";  dashed = mean of uniform sampling \", NumberForm[Mean[costVec], {4, \
1}]}]]\
\>", "Input",
 FontSize->9,
 CellTags->"hist",ExpressionUUID->"ef82b13f-208b-ce47-915c-c64d2d6aab47"],

